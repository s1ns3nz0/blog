---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Card from "@/components/Card.astro";
import TagGroups from "@/components/TagGroups.astro";
import Footer from "@/components/Footer.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { TAG_GROUPS } from "@/utils/tagGroups";
import { useTranslations } from "@/i18n";
import config from "@/config";

const allPosts = await getCollection("posts", ({ data }) => !data.draft);

// AWS and Kubernetes posts first (newest first), then the rest by date.
// Blockchain, Lightning, and postmortem series stay in date order even when
// they carry a Kubernetes tag.
const cloudTags = new Set(
  TAG_GROUPS.filter(g => g.name === "AWS" || g.name === "Kubernetes").flatMap(g => g.tags)
);
const notPinned = new Set([
  "Layer 2", "Lightning Network", "lnd", "Kagent", "SRE Postmortem",
  "Lineth L2 Lifecycle", "LND on Kubernetes",
]);
const pinned = ({ data }: (typeof allPosts)[number]) =>
  data.tags.some(t => cloudTags.has(t)) && !data.tags.some(t => notPinned.has(t));
const sorted = getSortedPosts(allPosts).filter(({ data }) => !data.unlisted);
// Within the pinned set, the Hoodi validator posts come after the rest.
const hoodi = ({ data }: (typeof allPosts)[number]) => data.tags.includes("Hoodi");
const posts = [
  ...sorted.filter(p => pinned(p) && !hoodi(p)),
  ...sorted.filter(p => pinned(p) && hoodi(p)),
  ...sorted.filter(p => !pinned(p)),
];

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
---

<Layout title={`${t.pages.postsTitle} | ${config.site.title}`}>
  <Header />

  <Breadcrumb />

  <Main pageTitle={t.pages.postsTitle} pageDesc={t.pages.postsDesc}>
    <p class="text-muted-foreground mb-4 text-sm">{t.pages.tagFilterHint}</p>
    <details class="mb-4 xl:hidden">
      <summary class="hover:text-accent cursor-pointer font-mono text-sm font-semibold">
        Filter by tag
      </summary>
      <TagGroups />
    </details>
    <div data-selected-tags class="mb-6 hidden flex-wrap gap-2"></div>
    <ul data-post-list>
      {posts.map(data => <Card {...data} />)}
    </ul>
    <p
      data-post-list-empty
      class="text-muted-foreground hidden py-8 text-center"
    >
      {t.a11y.noResults}
    </p>
  </Main>

  <Footer />
</Layout>
