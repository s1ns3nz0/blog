---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Card from "@/components/Card.astro";
import Footer from "@/components/Footer.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { getUniqueTags } from "@/utils/getUniqueTags";
import { groupTags } from "@/utils/groupTags";
import { TAG_GROUPS } from "@/utils/tagGroups";
import { slugifyAll } from "@/utils/slugify";
import { useTranslations } from "@/i18n";
import config from "@/config";

// Tags used on only one post add noise without adding filtering power
// (selecting one just points back at the post you already found it on).
const MIN_FILTERABLE_TAG_COUNT = 2;

const allPosts = await getCollection("posts", ({ data }) => !data.draft);
const posts = getSortedPosts(allPosts);
const tags = getUniqueTags(allPosts);

const tagCounts = new Map<string, number>();
for (const post of posts) {
  for (const tag of slugifyAll(post.data.tags)) {
    tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
  }
}
const filterableTags = tags.filter(
  ({ tag }) => (tagCounts.get(tag) ?? 0) >= MIN_FILTERABLE_TAG_COUNT
);
const tagGroups = groupTags(filterableTags, TAG_GROUPS);

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
---

<Layout title={`${t.pages.postsTitle} | ${config.site.title}`}>
  <Header />

  <Breadcrumb />

  <Main pageTitle={t.pages.postsTitle} pageDesc={t.pages.postsDesc}>
    {
      tagGroups.length > 0 && (
        <div id="post-tag-filter" class="mb-8 flex flex-col gap-2">
          {tagGroups.map(({ name, tags: groupTags }) => (
            <details class="border-border border-b border-dashed pb-2" open>
              <summary class="cursor-pointer py-1 font-mono text-sm font-semibold tracking-wider uppercase">
                {name}
              </summary>
              <div class="flex flex-wrap gap-2 pt-2">
                {groupTags.map(({ tag, tagName }) => (
                  <button
                    type="button"
                    data-tag={tag}
                    aria-pressed="false"
                    class:list={[
                      "border-border text-muted-foreground rounded-full border border-dashed px-3 py-1",
                      "font-mono text-sm transition-colors",
                      "hover:border-accent hover:text-accent",
                      "focus-visible:border-accent focus-visible:outline-none",
                      "aria-pressed:border-accent aria-pressed:text-accent aria-pressed:bg-accent/10",
                    ]}
                  >
                    #{tagName}
                  </button>
                ))}
              </div>
            </details>
          ))}
        </div>
      )
    }
    <p
      id="post-tag-filter-empty"
      class="text-muted-foreground hidden py-8 text-center"
    >
      {t.a11y.noResults}
    </p>
    <ul id="post-list">
      {posts.map(data => <Card {...data} />)}
    </ul>
  </Main>

  <Footer />
</Layout>

<script>
  function initPostTagFilter() {
    const filterBar = document.querySelector<HTMLElement>("#post-tag-filter");
    const list = document.querySelector<HTMLElement>("#post-list");
    const empty = document.querySelector<HTMLElement>(
      "#post-tag-filter-empty"
    );
    if (!filterBar || !list) return;

    const buttons = Array.from(
      filterBar.querySelectorAll<HTMLButtonElement>("button[data-tag]")
    );
    const items = Array.from(
      list.querySelectorAll<HTMLLIElement>("li[data-tags]")
    );
    const selected = new Set<string>();

    function apply() {
      let visibleCount = 0;
      for (const item of items) {
        const itemTags = (item.dataset.tags ?? "").split(",");
        const matches =
          selected.size === 0 ||
          [...selected].every(tag => itemTags.includes(tag));
        item.classList.toggle("hidden", !matches);
        if (matches) visibleCount++;
      }
      empty?.classList.toggle("hidden", visibleCount > 0);
    }

    for (const button of buttons) {
      button.addEventListener("click", () => {
        const tag = button.dataset.tag;
        if (!tag) return;

        if (selected.has(tag)) {
          selected.delete(tag);
          button.setAttribute("aria-pressed", "false");
        } else {
          selected.add(tag);
          button.setAttribute("aria-pressed", "true");
        }

        apply();
      });
    }
  }

  document.addEventListener("astro:after-swap", initPostTagFilter);
  initPostTagFilter();
</script>
