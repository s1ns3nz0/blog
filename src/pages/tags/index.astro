---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import Tag from "@/components/Tag.astro";
import { getUniqueTags } from "@/utils/getUniqueTags";
import { groupTags } from "@/utils/groupTags";
import { TAG_GROUPS } from "@/utils/tagGroups";
import { useTranslations } from "@/i18n";
import config from "@/config";

const posts = await getCollection("posts", ({ data }) => !data.draft);
const tags = getUniqueTags(posts);
const tagGroups = groupTags(tags, TAG_GROUPS);

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
---

<Layout title={`${t.pages.tagsTitle} | ${config.site.title}`}>
  <Header />

  <Breadcrumb />

  <Main pageTitle={t.pages.tagsTitle} pageDesc={t.pages.tagsDesc}>
    <div class="flex flex-col gap-8">
      {
        tagGroups.map(({ name, tags: groupTags }) => (
          <div>
            <h2 class="text-2xl font-bold">{name}</h2>
            <ul class="mt-3 flex flex-wrap gap-6">
              {groupTags.map(({ tag, tagName }) => (
                <Tag {tag} {tagName} />
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </Main>

  <Footer />
</Layout>
