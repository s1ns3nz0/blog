---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import SreLayout from "@/layouts/SreLayout.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { getPostUrl } from "@/utils/getPostPaths";
import { slugifyStr } from "@/utils/slugify";
import config from "@/config";
import IconGitHub from "@/assets/icons/brands/github.svg";
import IconLinkedIn from "@/assets/icons/brands/linkedin.svg";
import IconGmail from "@/assets/icons/brands/gmail.svg";
import { career, education } from "@/data/portfolio";
import { sreIdentity, stages, shifts, zones, findings, builtOn, nodes, alsoRunning, certGroups, profile, SKY_TZ, SRE_OPS_LIVE, SRE_OPS_REPO } from "@/data/sre";
import "@/styles/sre.css";

// Node cards: featured posts must be published and listed (drafts drop out until they are);
// the count is every published post with the card's tag.
const posts = getSortedPosts(await getCollection("posts")).filter(p => !p.data.unlisted);
const postById = new Map(posts.map(p => [p.id, p]));
const postLinks = (ids: string[]) =>
  ids.flatMap(id => {
    const p = postById.get(id);
    return p ? [{ title: p.data.title, url: getPostUrl(p.id, p.filePath) }] : [];
  });
const nodeCards = nodes.map(n => ({
  ...n,
  featured: postLinks(n.posts),
  grouped: (("groups" in n && n.groups) || []).map(g => ({ title: g.title, posts: postLinks(g.posts) })),
  count: posts.filter(p => n.tags.some(t => p.data.tags.includes(t))).length,
  tagUrl: `/tags/${slugifyStr(n.tags[0])}/`,
}));
const mainNode = nodeCards.find(n => n.id === "l2")!;
// "Lineth L2 Transaction Lifecycle (3) - Inside…" → "(3) Inside…"; the group heading names the series.
const shortTitle = (t: string) =>
  t.replace(/^Lineth L2 (?:Transaction Lifecycle|Incident Management: Postmortem) (\(\d+\)) - /, "$1 ");

// Same contacts as the home page.
const brandIcons = { github: IconGitHub, linkedin: IconLinkedIn, mail: IconGmail };
const brandLabel: Record<string, string> = { github: "GitHub", linkedin: "LinkedIn", mail: "Email" };
const contacts = config.socials
  .filter(s => s.name in brandIcons)
  .map(s => ({ url: s.url, label: brandLabel[s.name], Icon: brandIcons[s.name as keyof typeof brandIcons] }));
const certCount = certGroups.flatMap(g => g.items).reduce((n, c) => n + (c.chips?.length ?? 1), 0);
const tagCount = (tag: string) => posts.filter(p => p.data.tags.includes(tag)).length;
const others = alsoRunning.map(n => ({ ...n, count: n.tag ? tagCount(n.tag) : 0, tagUrl: n.tag ? `/tags/${slugifyStr(n.tag)}/` : "" }));

// Clocks and sky for each point, computed here so the page needs no Intl at runtime.
const DAY = "2026-10-13";
const at = (utc: string) => new Date(`${DAY}T${utc}:00Z`);
const hhmm = (d: Date, tz: string) =>
  d.toLocaleTimeString("en-GB", { timeZone: tz, hour: "2-digit", minute: "2-digit", hourCycle: "h23" });
const minutes = (utc: string) => {
  const [h, m] = utc.split(":").map(Number);
  return h * 60 + m;
};
const shiftAt = (utc: string) => shifts.find(s => minutes(utc) >= s.start * 60 && minutes(utc) < s.end * 60)!;

// Sky by local hour: [hour, top, bottom, stars 0..1]. Colours in between are interpolated.
const SKY: [number, string, string, number][] = [
  [8, "#8cc0ee", "#f6e3c6", 0],
  [12, "#5aa6e6", "#d6ecfb", 0],
  [15, "#6aa5d8", "#f4dfb6", 0],
  [17, "#3b3a78", "#f2945e", 0.1],
  [19, "#1b1f4a", "#6a4a7a", 0.5],
  [23, "#070b1a", "#121a36", 1],
];
const hex = (c: string) => [1, 3, 5].map(i => parseInt(c.slice(i, i + 2), 16));
const mix = (a: string, b: string, t: number) =>
  `rgb(${hex(a).map((v, i) => Math.round(v + (hex(b)[i] - v) * t)).join(" ")})`;
const skyAt = (utc: string) => {
  const [h, m] = hhmm(at(utc), SKY_TZ).split(":").map(Number);
  const x = Math.min(SKY.at(-1)![0], Math.max(SKY[0][0], h + m / 60));
  const j = Math.max(1, SKY.findIndex(s => s[0] >= x));
  const [a, b] = [SKY[j - 1], SKY[j]];
  const t = (x - a[0]) / (b[0] - a[0]);
  return { top: mix(a[1], b[1], t), bottom: mix(a[2], b[2], t), stars: a[3] + (b[3] - a[3]) * t };
};
// The band covers 00:00-16:00 UTC: the APAC and EU shifts, where the whole day happened.
const RANGE_MIN = 16 * 60;
const pct = (utc: string) => Math.min(100, (minutes(utc) / RANGE_MIN) * 100);
const bandShifts = shifts.filter(s => s.start * 60 < RANGE_MIN);
const point = (utc: string) => ({
  pos: pct(utc),
  times: zones.map(z => hhmm(at(utc), z.tz)),
  shift: shiftAt(utc).name,
  sky: skyAt(utc),
});
const attrs = (p: ReturnType<typeof point>) => ({
  "data-pos": p.pos,
  "data-times": JSON.stringify(p.times),
  "data-shift": p.shift,
  "data-sky": JSON.stringify(p.sky),
});

const hero = point("00:00"); // the APAC shift starts
const stageData = stages.map(s => ({ ...s, ...point(s.utc) }));
const end = stageData.at(-1)!;
const cta = [
  { label: "Open the live console", url: SRE_OPS_LIVE, primary: true },
  { label: "Source on GitHub", url: SRE_OPS_REPO, primary: false },
];
---

<SreLayout
  title={`SRE | ${sreIdentity.title} | Jinsoo Yang`}
  description={`${sreIdentity.claim} The incident lifecycle, the on-call problems in each stage, and the console I built to solve them.`}
>
  <div class="sky" data-sky-layer style={`--sky-top:${hero.sky.top};--sky-bottom:${hero.sky.bottom};--stars:${hero.sky.stars}`} aria-hidden="true">
    <div class="stars"></div>
  </div>

  <header class="band" data-band data-shift={hero.shift} aria-label="Time of the scene">
    <div class="band-track">
      {bandShifts.map(s => (
        <span class="band-shift" data-shift={s.name} style={`left:${(s.start * 60 / RANGE_MIN) * 100}%;width:${((s.end - s.start) * 60 / RANGE_MIN) * 100}%`} aria-hidden="true">
          {s.name}
        </span>
      ))}
      <span class="band-fill" data-band-fill style={`width:${hero.pos}%`} aria-hidden="true"></span>
      <ol class="band-pins" aria-label="Incident lifecycle">
        {stageData.map((s, i) => (
          <li style={`left:${s.pos}%`} class:list={{ "pin-left": s.pos > 70 }}>
            <a class="pin" href={`#${s.id}`} data-stage-link={s.id} title={`${s.name} · ${s.utc} UTC`}>
              <span>{i + 1}</span>
              <em>{s.name} · {s.utc}</em>
            </a>
          </li>
        ))}
      </ol>
      <span class="band-next" aria-hidden="true">US 16:00 →</span>
    </div>
    <div class="band-clocks">
      {zones.map((z, i) => (
        <span class:list={["band-clock", { "band-ref": i === 0 }]}>
          <b>{z.label}</b> <span data-band-clock={i}>{hero.times[i]}</span>
        </span>
      ))}
    </div>
  </header>

  <main class="page" data-ink>
    <section class="hero" data-point {...attrs(hero)}>
      <div class="who">
        <p class="kicker"><b>{profile.name}</b> · {sreIdentity.title} · {sreIdentity.openTo}</p>
        <nav class="contacts" aria-label="Contact">
          {contacts.map(c => (
            <a href={c.url} target={c.url.startsWith("mailto:") ? undefined : "_blank"} rel="noopener noreferrer">
              <c.Icon aria-hidden="true" /><span>{c.label}</span>
            </a>
          ))}
        </nav>
      </div>
      <h1 class="claim">{sreIdentity.claim}</h1>
      <p class="lede">{sreIdentity.lede}</p>
    </section>

    <section class="findings-wrap" aria-labelledby="findings-title">
      <header class="section-head findings-head">
        <div>
          <p class="section-num">01</p>
          <h2 id="findings-title">Six problems I kept running into on call</h2>
          <p>Select a solution to see how it works.</p>
        </div>
        <nav class="cta" aria-label="Console">
          {cta.map(c => (
            <a class:list={{ primary: c.primary }} href={c.url} target="_blank" rel="noopener noreferrer">{c.label} ↗</a>
          ))}
        </nav>
      </header>
      <div class="panel">
      <p class="label facts-head">Where I ran into them</p>
      <ul class="facts">
        {sreIdentity.facts.map(f => (
          <li>
            <b>{f.value}</b>
            <span><strong>{f.org}</strong> {f.label}</span>
          </li>
        ))}
      </ul>
        <div class="findings-cols" aria-hidden="true">
          <span class="label label-problem">Problem</span>
          <span class="label label-solution">What I built</span>
        </div>
        <ol class="findings">
          {findings.map(f => {
            const stage = stageData.find(s => s.id === f.stage)!;
            return (
              <li>
                <details>
                  <summary>
                    <span class="finding-problem"><em class="label label-problem">Problem</em>{f.problem}</span>
                    <span class="finding-built"><em class="label label-solution">What I built</em>{f.built}</span>
                  </summary>
                  <div class="finding-more">
                    <p class="label">How it works</p>
                    <ul>
                      {f.details.map(d => <li>{d}</li>)}
                    </ul>
                    <a href={`#${stage.id}`}>See it in the console: {stage.name} ↓</a>
                  </div>
                </details>
              </li>
            );
          })}
        </ol>
        <div class="built-on">
          <p class="label">{builtOn.title}</p>
          <p>{builtOn.text} <a href="#nodes">See the nodes ↓</a></p>
          <ul>
            {builtOn.layers.map(l => (
              <li><b>{l.name}</b>{l.parts.map(x => <span>{x}</span>)}</li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <header class="section-head">
      <p class="section-num">02</p>
      <h2>{sreIdentity.lifecycleTitle}</h2>
      <p>{sreIdentity.lifecycleNote}</p>
    </header>

    <ol class="log">
      {stageData.map((s, i) => (
        <li class="entry panel" id={s.id} data-point data-stage={s.id} {...attrs(s)}>
          <div class="entry-meta">
            <p class="entry-time">{s.utc} UTC</p>
            <p class="entry-name"><span>{i + 1}</span>{s.name}</p>
            <p class="entry-step">{i + 1} / {stageData.length}</p>
          </div>
          <div class="entry-body">
            {s.blocks.map((blk, k) => (
              <div class="block">
                {blk.items.map((it, j) => (
                  <div class="pair">
                    {blk.items.length > 1 && <span class="pair-num" aria-hidden="true">{j + 1}</span>}
                    <div>
                      <p class="label label-problem">Problem</p>
                      <h3 class="pair-problem">{it.problem}</h3>
                      <p class="pair-stat">{it.stat}</p>
                      <p class="label label-solution">Solution</p>
                      <p class="pair-solution">{it.solution}</p>
                    </div>
                  </div>
                ))}
                <figure class="frame">
                  <div class="frame-bar">
                    <i aria-hidden="true"></i><i aria-hidden="true"></i><i aria-hidden="true"></i>
                    <span>AI SRE Ops · {blk.shot.page}</span>
                    <a href={`${SRE_OPS_LIVE}${blk.shot.path}`} target="_blank" rel="noopener noreferrer">Open this page ↗</a>
                  </div>
                  <div class="frame-screen">
                    <Image src={blk.shot.src} alt={blk.shot.alt} widths={[640, 1280, 2000]} sizes="(min-width: 1100px) 1000px, 100vw" />
                    <svg class="frame-focus" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
                      <mask id={`focus-${s.id}-${k}`}>
                        <rect width="100" height="100" fill="#fff" />
                        {blk.shot.focus.map(f => <rect x={f.x} y={f.y} width={f.w} height={f.h} rx="0.6" fill="#000" />)}
                      </mask>
                      <rect class="frame-dim" width="100" height="100" mask={`url(#focus-${s.id}-${k})`} />
                      {blk.shot.focus.map(f => <rect class="frame-box" x={f.x} y={f.y} width={f.w} height={f.h} rx="0.6" />)}
                    </svg>
                    {blk.items.length > 1 && blk.shot.focus.map((f, j) => (
                      <span class="frame-badge" style={`left:${Math.min(f.x + f.w, 97)}%;top:${Math.max(f.y, 3)}%`}>{j + 1}</span>
                    ))}
                  </div>
                </figure>
              </div>
            ))}
          </div>
        </li>
      ))}
    </ol>

  </main>

  <!-- The operator: a different register from the console story above. -->
  <section class="operator" id="nodes" data-point {...attrs(end)} aria-labelledby="operator-title">
    <div class="operator-inner">
      <header class="operator-head">
        <div>
          <p class="operator-kicker">The operator</p>
          <h2 id="operator-title">{profile.name}</h2>
          <p class="operator-bio">{profile.bio}</p>
        </div>
        <nav class="contacts" aria-label="Contact">
          {contacts.map(c => (
            <a href={c.url} target={c.url.startsWith("mailto:") ? undefined : "_blank"} rel="noopener noreferrer">
              <c.Icon aria-hidden="true" /><span>{c.label}</span>
            </a>
          ))}
        </nav>
      </header>

      <h3 class="operator-sub">Nodes I run</h3>
      <article class="rig rig-main">
        <p class="rig-kind"><i aria-hidden="true"></i>{mainNode.kind}</p>
        <h4>{mainNode.name}</h4>
        <p class="rig-where">{mainNode.facts[0].v} · {mainNode.facts[1].v}</p>
        <p class="rig-what">{mainNode.facts[2].v}</p>
        <div class="rig-groups">
          {mainNode.grouped.map(g => (
            <section>
              <p class="rig-group">{g.title}</p>
              <ul>{g.posts.map(p => <li><a href={p.url}>{shortTitle(p.title)}</a></li>)}</ul>
            </section>
          ))}
        </div>
        <a class="rig-all" href={mainNode.tagUrl}>All {mainNode.count} posts →</a>
      </article>

      <details class="also">
        <summary>
          <span class="also-label">Also running</span>
          <span class="also-list">{others.map(n => `${n.name} (${n.env === "AWS" ? "AWS, earlier build" : n.env.toLowerCase()})`).join(" · ")}</span>
        </summary>
        <ul class="also-cards">
          {others.map(n => (
            <li class:list={["rig", "also-card", n.status !== "Running" && "is-past"]}>
              <p class="rig-kind"><i aria-hidden="true"></i>{n.status} · {n.env}</p>
              <h4>{n.name}</h4>
              <p class="rig-where">{n.where}</p>
              <ul class="stack-chips">{n.stack.map(t => <li>{t}</li>)}</ul>
              <ul class="proofs">
                {n.proofs.map(p => (
                  <li>{p.url ? <a href={p.url} target="_blank" rel="noopener noreferrer">{p.text} ↗</a> : p.text}</li>
                ))}
              </ul>
              {(n.tag || n.links.length > 0) && (
                <p class="also-links">
                  {n.tag && <a href={n.tagUrl}>{n.count} posts →</a>}
                  {n.links.map(l => <a href={l.url} target="_blank" rel="noopener noreferrer">{l.label} ↗</a>)}
                </p>
              )}
            </li>
          ))}
        </ul>
      </details>

      <h3 class="operator-sub">Experience</h3>
      <ol class="timeline">
        {[...career].reverse().map(c => (
          <li>
            <span class="tl-year">{c.period.split(" – ")[0].split(" ").at(-1)}</span>
            <b>{c.org}</b>
            <span>{c.role}</span>
            <i>{c.period}</i>
          </li>
        ))}
      </ol>

      <h3 class="operator-sub">Certifications · {certCount}</h3>
      <div class="certs">
        {certGroups.map(g => (
          <section class="cert-group">
            <p class="rig-group">{g.issuer}</p>
            <ul>
              {g.items.map(c => (
                <li>
                  <b>{c.name}</b>
                  {c.ko && <span lang="ko">{c.ko}</span>}
                  {c.chips && <ul class="stack-chips">{c.chips.map(t => <li>{t}</li>)}</ul>}
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>

      <h3 class="operator-sub">Education</h3>
      <ul class="edu">{education.map(e => <li><b>{e.degree}</b><span>{e.school}</span><i>{e.period}</i></li>)}</ul>

      <p class="operator-foot"><a href="/">{profile.more} →</a></p>
    </div>
  </section>

  <a class="to-top" href="#" data-to-top aria-label="Back to top">↑</a>

  <script>
    type Sky = { top: string; bottom: string; stars: number };
    const layer = document.querySelector<HTMLElement>("[data-sky-layer]")!;
    const page = document.querySelector<HTMLElement>("[data-ink]")!;
    const band = document.querySelector<HTMLElement>("[data-band]")!;
    const fill = document.querySelector<HTMLElement>("[data-band-fill]");
    const clocks = [...document.querySelectorAll<HTMLElement>("[data-band-clock]")];
    const links = [...document.querySelectorAll<HTMLElement>("[data-stage-link]")];
    const points = [...document.querySelectorAll<HTMLElement>("[data-point]")];
    const skies: Sky[] = points.map(p => JSON.parse(p.dataset.sky!));
    const rgb = (c: string) => c.match(/\d+/g)!.map(Number);
    const mix = (a: string, b: string, t: number) =>
      `rgb(${rgb(a).map((v, i) => Math.round(v + (rgb(b)[i] - v) * t)).join(" ")})`;
    // Relative luminance of the sky's middle, where the text sits: dark text by day, light at dusk and night.
    const lum = (c: string) =>
      rgb(c)
        .map(v => v / 255)
        .map(v => (v <= 0.04045 ? v / 12.92 : ((v + 0.055) / 1.055) ** 2.4))
        .reduce((s, v, i) => s + v * [0.2126, 0.7152, 0.0722][i], 0);
    const paint = (k: Sky) => {
      layer.style.setProperty("--sky-top", k.top);
      layer.style.setProperty("--sky-bottom", k.bottom);
      layer.style.setProperty("--stars", String(k.stars));
      page.dataset.ink = lum(mix(k.top, k.bottom, 0.5)) > 0.3 ? "dark" : "light";
    };
    const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;

    let current = -1;
    const show = (i: number) => {
      if (i === current) return;
      current = i;
      const el = points[i];
      if (fill) fill.style.width = `${el.dataset.pos}%`;
      band.dataset.shift = el.dataset.shift;
      const times: string[] = JSON.parse(el.dataset.times ?? "[]");
      clocks.forEach((c, j) => (c.textContent = times[j] ?? c.textContent));
      const stage = el.dataset.stage;
      points.forEach(p => p.toggleAttribute("data-active", p === el && !!stage));
      links.forEach(l => l.toggleAttribute("data-active", l.dataset.stageLink === stage));
      if (reduced) paint(skies[i]);
    };

    // Blend between the two points around the middle of the screen.
    const toTop = document.querySelector<HTMLElement>("[data-to-top]")!;
    const onScroll = () => {
      toTop.toggleAttribute("data-show", scrollY > innerHeight * 0.8);
      const mid = innerHeight / 2;
      const centers = points.map(p => {
        const r = p.getBoundingClientRect();
        return r.top + Math.min(r.height, innerHeight) / 2;
      });
      let i = centers.findIndex(c => c > mid);
      if (i === -1) i = points.length;
      const a = Math.max(0, i - 1);
      const b = Math.min(points.length - 1, i);
      const t = a === b ? 0 : Math.min(1, Math.max(0, (mid - centers[a]) / (centers[b] - centers[a])));
      show(t < 0.5 ? a : b);
      if (!reduced) {
        const A = skies[a], B = skies[b];
        paint({ top: mix(A.top, B.top, t), bottom: mix(A.bottom, B.bottom, t), stars: A.stars + (B.stars - A.stars) * t });
      }
    };
    addEventListener("scroll", () => requestAnimationFrame(onScroll), { passive: true });
    onScroll();
  </script>
</SreLayout>
