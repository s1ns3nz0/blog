---
/**
 * Line-art rocket for /launch. The labels carry the story: the PLATFORM and
 * PIPELINE boosters fall away once their job is done, and the fairing splits
 * open in orbit to release the product (a satellite, later the AI assistant).
 * launch.css drives every part from html[data-stage]; purely decorative.
 */
import { identity, fairingTextLength } from "@/data/portfolio";
---

<div class="rocket" aria-hidden="true">
  <svg viewBox="0 0 100 440" xmlns="http://www.w3.org/2000/svg">
    <g class="r-stage1">
      <rect x="30" y="200" width="40" height="150" rx="2" />
      <line x1="30" y1="230" x2="70" y2="230" />
      <line x1="30" y1="320" x2="70" y2="320" />
      <text
        x="50"
        y="279"
        transform="rotate(-90 50 275)"
        text-anchor="middle"
        textLength="74"
        lengthAdjust="spacingAndGlyphs">PLATFORM</text
      >
      <path d="M30 300 L10 352 L30 346 Z" />
      <path d="M70 300 L90 352 L70 346 Z" />
      <path d="M38 350 L34 364 L66 364 L62 350 Z" />
      <path class="r-flame r-flame1" d="M36 366 Q50 440 64 366 Z" />
    </g>

    <g class="r-stage2">
      <rect x="32" y="96" width="36" height="104" rx="2" />
      <line x1="32" y1="120" x2="68" y2="120" />
      <text
        x="50"
        y="164"
        transform="rotate(-90 50 160)"
        text-anchor="middle"
        textLength="62"
        lengthAdjust="spacingAndGlyphs">PIPELINE</text
      >
      <path d="M41 200 L38 210 L62 210 L59 200 Z" />
      <path class="r-flame r-flame2" d="M39 212 Q50 270 61 212 Z" />
    </g>

    <g class="r-kick">
      <path d="M44 96 L42 104 L58 104 L56 96 Z" />
      <path class="r-flame r-flame3" d="M43 106 Q50 140 57 106 Z" />
    </g>

    <!-- The product: a folded satellite that sits inside the fairing. -->
    <g class="r-sat">
      <g class="r-panel r-panel-l">
        <line x1="36" y1="63" x2="40" y2="63" />
        <rect class="cell" x="4" y="56" width="32" height="14" />
        <line x1="12" y1="56" x2="12" y2="70" />
        <line x1="20" y1="56" x2="20" y2="70" />
        <line x1="28" y1="56" x2="28" y2="70" />
        <line x1="4" y1="63" x2="36" y2="63" />
      </g>
      <g class="r-panel r-panel-r">
        <line x1="60" y1="63" x2="64" y2="63" />
        <rect class="cell" x="64" y="56" width="32" height="14" />
        <line x1="72" y1="56" x2="72" y2="70" />
        <line x1="80" y1="56" x2="80" y2="70" />
        <line x1="88" y1="56" x2="88" y2="70" />
        <line x1="64" y1="63" x2="96" y2="63" />
      </g>
      <line x1="50" y1="48" x2="50" y2="45" />
      <path d="M40 42 Q50 51 60 42 Z" />
      <line x1="50" y1="42" x2="50" y2="37" />
      <circle class="r-beacon" cx="50" cy="35" r="2.2" />
      <rect x="40" y="48" width="20" height="30" rx="2" />
      <!-- chat bubble: this product answers questions -->
      <rect class="r-bubble" x="43.5" y="55" width="13" height="9" rx="2.5" />
      <path class="r-bubble" d="M47 64 L45.5 68.5 L50.5 64" />
    </g>

    <g class="r-fairing r-fairing-l">
      <path d="M50 6 C34 36 32 62 32 96 L50 96 Z" />
      <text
        class="r-fairing-text"
        x="43"
        y="70"
        transform="rotate(-90 43 67)"
        text-anchor="middle"
        textLength={fairingTextLength(identity.fairing)}
        lengthAdjust="spacingAndGlyphs"
        data-fairing-label>{identity.fairing}</text
      >
    </g>
    <g class="r-fairing r-fairing-r">
      <path d="M50 6 C66 36 68 62 68 96 L50 96 Z" />
    </g>
  </svg>
</div>
