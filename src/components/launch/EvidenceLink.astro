---
/** An evidence link, opened in a new tab so the flight keeps its place; external pages get ↗. */
type Props = { title: string; url: string; external: boolean };
const { title, url, external } = Astro.props;
---

{
  external ? (
    <a href={url} target="_blank" rel="noopener noreferrer">
      {title} <span aria-label="(opens in a new tab)">↗</span>
    </a>
  ) : (
    <a href={url} target="_blank" rel="noopener">{title}</a>
  )
}
