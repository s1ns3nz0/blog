---
import type { CollectionEntry } from "astro:content";
import { getPostUrl } from "@/utils/getPostPaths";
import { getReadingTime } from "@/utils/getReadingTime";
import { toTransitionName } from "@/utils/toTransitionName";
import { slugifyAll } from "@/utils/slugify";
import Datetime from "./Datetime.astro";

type Props = {
  variant?: "h2" | "h3";
} & CollectionEntry<"posts">;

const { variant: Heading = "h2", id, data, filePath, body } = Astro.props;

const { title, description, tags, pubDatetime, modDatetime, timezone } = data;

const postUrl = getPostUrl(id, filePath, Astro.currentLocale);
const readingTime = getReadingTime(body);
---

<li class="my-6 list-none" data-tags={slugifyAll(tags).join(",")}>
  <a
    href={postUrl}
    class:list={[
      "group border-border flex flex-col-reverse gap-4 rounded-xl border bg-white/[0.03] p-4",
      "transition hover:-translate-y-0.5 hover:border-foreground/25 hover:shadow-lg hover:shadow-slate-900/5",
      "focus-visible:border-accent focus-visible:outline-none",
      "sm:flex-row sm:items-center sm:gap-6 sm:p-5",
    ]}
  >
    <div class="min-w-0 flex-1">
      {
        tags.length > 0 && (
          <div class="text-muted-foreground mb-1.5 flex flex-wrap gap-x-3 font-mono text-xs tracking-widest uppercase">
            {tags.slice(0, 3).map(tag => (
              <span>#{tag}</span>
            ))}
          </div>
        )
      }
      <Heading
        transition:name={toTransitionName(title)}
        class="text-lg font-semibold sm:text-xl"
      >
        {title}
      </Heading>
      <p class="text-muted-foreground mt-1 line-clamp-2">{description}</p>
      <div
        class="text-muted-foreground mt-3 flex flex-wrap items-center gap-x-5 font-mono text-xs tracking-wider uppercase"
      >
        <Datetime {pubDatetime} {modDatetime} {timezone} />
        <span>{readingTime}</span>
      </div>
    </div>
  </a>
</li>
