---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import { postFilter } from "@/utils/postFilter";
import { slugifyStr } from "@/utils/slugify";
import { stripBase, stripLocale } from "@/utils/withBase";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;

const posts = await getCollection("posts", ({ data }) => !data.draft);
const published = posts.filter(postFilter);

const counts = new Map<string, number>();
for (const post of published) {
  for (const tagName of post.data.tags) {
    const slug = slugifyStr(tagName);
    counts.set(slug, (counts.get(slug) ?? 0) + 1);
  }
}

// Groups = named tag groups from config. Ungrouped tags are not shown here.
const groups = config.nav.tagGroups.map(group => ({
  name: group.name,
  tags: group.tags.map(tagName => ({ tag: slugifyStr(tagName), tagName })),
}));
// Legacy single-tag pins still act as one-tag groups.
for (const tagName of config.nav.pinnedTags) {
  groups.push({
    name: tagName,
    tags: [{ tag: slugifyStr(tagName), tagName }],
  });
}

// Slug -> display name for every selectable tag, read by the filter script
// to render the "selected tags" chip bar at the top of the content area.
const tagNameBySlug = Object.fromEntries(
  groups.flatMap(g => g.tags.map(({ tag, tagName }) => [tag, tagName]))
);

const currentPath = stripLocale(stripBase(Astro.url.pathname), locale).replace(
  /\/+$/,
  ""
);

const tagUrl = (slug: string) => getRelativeLocaleUrl(locale, `tags/${slug}/`);
const isTagActive = (slug: string) => currentPath === `/tags/${slug}`;
---

<aside
  transition:persist
  class:list={[
    "fixed top-28 left-[calc(50%-39rem)] hidden w-52 xl:block",
    "max-h-[calc(100dvh-9rem)] overflow-y-auto pb-8",
  ]}
  aria-label="Tags and pages"
>
  <nav class="flex flex-col gap-6">
    {
      groups.length > 0 && (
        <section>
          <h2 class="text-muted-foreground font-mono text-xs font-semibold tracking-widest uppercase">
            Groups
          </h2>
          <div class="mt-2 flex flex-col">
            {groups.map(group => {
              const groupActive = group.tags.some(t => isTagActive(t.tag));
              return (
                <details class="group/accordion" open={groupActive}>
                  <summary
                    class:list={[
                      "hover:text-accent marker:text-muted-foreground flex cursor-pointer items-center justify-between gap-2 py-1 font-medium",
                      groupActive ? "text-accent" : "text-foreground",
                    ]}
                  >
                    <span>{group.name}</span>
                    <span class="text-muted-foreground font-mono text-xs transition-transform group-open/accordion:rotate-90">
                      ›
                    </span>
                  </summary>
                  <ul class="mt-1 mb-2 hidden flex-col gap-1 ps-3 group-open/accordion:flex">
                    {group.tags.map(({ tag, tagName }) => (
                      <li>
                        <a
                          href={tagUrl(tag)}
                          data-tag={tag}
                          aria-pressed="false"
                          class:list={[
                            "hover:text-accent flex items-baseline justify-between gap-2 py-1",
                            "aria-pressed:text-accent aria-pressed:font-semibold",
                            isTagActive(tag)
                              ? "text-accent"
                              : "text-muted-foreground hover:text-accent",
                          ]}
                        >
                          <span class="truncate">{tagName}</span>
                          <span class="font-mono text-xs">
                            {counts.get(tag) ?? 0}
                          </span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </details>
              );
            })}
          </div>
        </section>
      )
    }

  </nav>
</aside>

<script type="application/json" id="sidebar-tag-names" set:html={JSON.stringify(tagNameBySlug)} />

<script>
  // Multi-tag AND filter, driven from the sidebar. Selection persists in
  // sessionStorage across soft navigations. A click only filters in place
  // when the current page already renders a post list ([data-post-list]);
  // otherwise it falls through to the tag's own /tags/{slug}/ page.
  const STORAGE_KEY = "sidebar-selected-tags";

  function getSelected(): Set<string> {
    try {
      const raw = sessionStorage.getItem(STORAGE_KEY);
      return new Set(raw ? (JSON.parse(raw) as string[]) : []);
    } catch {
      return new Set();
    }
  }

  function setSelected(selected: Set<string>) {
    sessionStorage.setItem(STORAGE_KEY, JSON.stringify([...selected]));
  }

  function getTagNames(): Record<string, string> {
    const raw = document.getElementById("sidebar-tag-names")?.textContent;
    try {
      return raw ? (JSON.parse(raw) as Record<string, string>) : {};
    } catch {
      return {};
    }
  }

  function markSelected(selected: Set<string>) {
    document
      .querySelectorAll<HTMLAnchorElement>("aside a[data-tag]")
      .forEach(link => {
        const tag = link.dataset.tag;
        link.setAttribute("aria-pressed", String(!!tag && selected.has(tag)));
      });
  }

  function renderSelectedChips(selected: Set<string>, onRemove: (tag: string) => void) {
    const bar = document.querySelector<HTMLElement>("[data-selected-tags]");
    if (!bar) return;

    bar.innerHTML = "";
    bar.classList.toggle("hidden", selected.size === 0);
    bar.classList.toggle("flex", selected.size > 0);
    if (selected.size === 0) return;

    const names = getTagNames();
    for (const tag of selected) {
      const chip = document.createElement("button");
      chip.type = "button";
      chip.dataset.tag = tag;
      chip.className = [
        "border-accent bg-accent/10 text-accent flex items-center gap-1.5",
        "rounded-full border border-dashed px-3 py-1 font-mono text-sm",
        "hover:bg-accent/20 focus-visible:outline-none",
      ].join(" ");
      chip.setAttribute("aria-label", `Remove ${names[tag] ?? tag} filter`);
      chip.innerHTML = `<span>#${names[tag] ?? tag}</span><span aria-hidden="true">×</span>`;
      chip.addEventListener("click", () => onRemove(tag));
      bar.append(chip);
    }
  }

  function applyFilter(selected: Set<string>) {
    const list = document.querySelector<HTMLElement>("[data-post-list]");
    if (!list) return;

    const items = list.querySelectorAll<HTMLLIElement>("li[data-tags]");
    let visibleCount = 0;
    items.forEach(item => {
      const itemTags = (item.dataset.tags ?? "").split(",");
      const matches =
        selected.size === 0 ||
        [...selected].every(tag => itemTags.includes(tag));
      item.classList.toggle("hidden", !matches);
      if (matches) visibleCount++;
    });

    document
      .querySelector("[data-post-list-empty]")
      ?.classList.toggle("hidden", visibleCount > 0 || items.length === 0);
  }

  function refresh() {
    const selected = getSelected();
    markSelected(selected);
    applyFilter(selected);
    renderSelectedChips(selected, tag => {
      const current = getSelected();
      current.delete(tag);
      setSelected(current);
      refresh();
    });
  }

  function initSidebarTagFilter() {
    refresh();

    document
      .querySelectorAll<HTMLAnchorElement>("aside a[data-tag]")
      .forEach(link => {
        if (link.dataset.filterBound) return;
        link.dataset.filterBound = "true";

        link.addEventListener("click", event => {
          const tag = link.dataset.tag;
          if (!tag) return;
          if (!document.querySelector("[data-post-list]")) return; // let it navigate

          event.preventDefault();
          const current = getSelected();
          if (current.has(tag)) current.delete(tag);
          else current.add(tag);
          setSelected(current);
          refresh();
        });
      });
  }

  document.addEventListener("astro:page-load", initSidebarTagFilter);
</script>
